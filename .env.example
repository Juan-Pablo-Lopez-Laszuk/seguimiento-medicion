# Copiar este archivo como .env y completar con los valores reales (no se sube a GitHub).

# Puerto del servidor local
PORT=8080

# Conexión a PostgreSQL de Supabase (usar el "Transaction pooler", puerto 6543)
DATABASE_URL=postgresql://postgres.<ref-del-proyecto>:<contraseña>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Opcional: conexión para aplicar las migraciones (go run ./cmd/migrar up). Si no está, usa DATABASE_URL.
# Si el pooler de transacciones (6543) da problemas con las migraciones, usar el "Session pooler" (puerto 5432).
MIGRATIONS_DATABASE_URL=

# Solo para correr los tests con base de datos: un PostgreSQL DESCARTABLE (por ejemplo el de Docker de
# CONTRIBUTING.md). Nunca apuntarla a Supabase: cada test crea y borra su propio esquema.
TEST_DATABASE_URL=postgres://postgres:test@localhost:54329/seguimiento?sslmode=disable

# Supabase Auth (Project Settings > API)
SUPABASE_URL=https://<ref-del-proyecto>.supabase.co
SUPABASE_ANON_KEY=<clave-anon-publica>
